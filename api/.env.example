# Render provides PORT automatically.
PORT=3000

# Public HTTPS URL of the Render Web Service.
BASE_URL=https://YOUR-SERVICE.onrender.com

# NOWPayments
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_IPN_CALLBACK_URL=https://YOUR-SERVICE.onrender.com/api/deposits/ipn

# Existing authentication JWT secret.
JWT_SECRET=

# PostgreSQL connection string.
# On Render this should normally come from the PostgreSQL database's
# Internal Database URL.
DATABASE_URL=

# Optional:
# Set this only if the frontend is hosted on another origin.
# Example:
# CORS_ORIGIN=https://your-frontend.example
CORS_ORIGIN=
